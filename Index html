    function calcBMI() {
      const w = parseFloat(document.getElementById("bmi-weight").value);
      const h = parseFloat(document.getElementById("bmi-height").value) / 100;
      if (!w || !h) return;
      const bmi = (w / (h * h)).toFixed(1);
      let status = bmi < 18.5 ? "Underweight" : bmi < 25 ? "Normal / Fit" : bmi < 30 ? "Overweight" : "Obese";
      const res = document.getElementById("bmi-result");
      res.classList.remove("hidden");
      res.innerHTML = `<p class="text-2xl font-bold text-amber-400">${bmi}</p><p class="text-xs text-slate-300 mt-1">Status: <strong>${status}</strong></p>`;
    }

    function calcBodyFat() {
      const h = parseFloat(document.getElementById("bf-height").value);
      const n = parseFloat(document.getElementById("bf-neck").value);
      const w = parseFloat(document.getElementById("bf-waist").value);
      if (!h || !n || !w || w <= n) return;
      const bf = (495 / (1.0324 - 0.19077 * Math.log10(w - n) + 0.15456 * Math.log10(h)) - 450).toFixed(1);
      const res = document.getElementById("bf-result");
      res.classList.remove("hidden");
      res.innerHTML = `<p class="text-2xl font-bold text-amber-400">${bf}%</p><p class="text-xs text-slate-300 mt-1">Estimated Body Fat Percentage</p>`;
    }

    function calcHR() {
      const age = parseInt(document.getElementById("hr-age").value);
      if (!age) return;
      const maxHr = Math.round(208 - 0.7 * age);
      const res = document.getElementById("hr-result");
      res.classList.remove("hidden");
      res.innerHTML = `
        <p class="text-sm font-bold text-white">Max Heart Rate: <span class="text-amber-400">${maxHr} bpm</span></p>
        <p class="text-emerald-400">• Fat Burn Zone (65-75%): <strong>${Math.round(maxHr*0.65)} - ${Math.round(maxHr*0.75)} bpm</strong></p>
        <p class="text-sky-400">• Cardio Endurance Zone (75-85%): <strong>${Math.round(maxHr*0.75)} - ${Math.round(maxHr*0.85)} bpm</strong></p>
        <p class="text-rose-400">• Peak Anaerobic Zone (85-95%): <strong>${Math.round(maxHr*0.85)} - ${Math.round(maxHr*0.95)} bpm</strong></p>
      `;
    }

    function calcHydration() {
      const w = parseFloat(document.getElementById("hyd-weight").value);
      const m = parseFloat(document.getElementById("hyd-mins").value) || 0;
      if (!w) return;
      const liters = (w * 0.033 + (m / 30) * 0.35).toFixed(2);
      const cals = Math.round(w * 32 + m * 7);
      const res = document.getElementById("hyd-result");
      res.classList.remove("hidden");
      res.innerHTML = `
        <p class="text-sky-400 font-bold text-sm">Daily Water Target: ${liters} Liters</p>
        <p class="text-amber-400 font-bold text-sm">Estimated Daily Maintenance Calories: ${cals} kcal</p>
      `;
    }

