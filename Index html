    function generatePftMarksheet() {
      const svc = document.getElementById("pft-svc").value.trim() || "N/A";
      const rankName = document.getElementById("pft-rank-name").value.trim() || "Candidate";
      const unit = document.getElementById("pft-unit").value.trim() || "SLAF";

      let totalObtained = 0;
      let totalPossible = 0;
      let allPassed = true;
      const rows = [];

      appData.pftEvents.forEach(ev => {
        const val = parseFloat(document.getElementById(`input-${ev.id}`).value);
        let score = 0;
        let passed = false;

        if (!isNaN(val)) {
          if (ev.type === "higher_better") {
            if (val >= ev.targetFull) score = ev.maxMarks;
            else if (val >= ev.minPass) {
              score = Math.round(50 + ((val - ev.minPass) / (ev.targetFull - ev.minPass)) * (ev.maxMarks - 50));
            } else {
              score = Math.max(0, Math.round((val / ev.minPass) * 49));
            }
            passed = val >= ev.minPass;
          } else {
            // lower_better (e.g. run time in seconds)
            if (val <= ev.targetFull) score = ev.maxMarks;
            else if (val <= ev.minPass) {
              score = Math.round(50 + ((ev.minPass - val) / (ev.minPass - ev.targetFull)) * (ev.maxMarks - 50));
            } else {
              score = Math.max(0, Math.round((ev.minPass / val) * 40));
            }
            passed = val <= ev.minPass;
          }
        }
        if (!passed) allPassed = false;
        totalObtained += score;
        totalPossible += ev.maxMarks;
        rows.push({ name: ev.name, raw: isNaN(val) ? "-" : val, score, max: ev.maxMarks, passed });
      });

      const pct = totalPossible ? ((totalObtained / totalPossible) * 100).toFixed(1) : 0;
      const grade = !allPassed ? "FAIL" : pct >= 85 ? "DISTINCTION (A)" : pct >= 70 ? "CREDIT (B)" : "PASS (C)";
      const today = new Date().toLocaleDateString();

      const out = document.getElementById("marksheet-output");
      out.classList.remove("hidden");
      out.innerHTML = `
        <div id="printable-marksheet" class="bg-white text-slate-900 rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-300">
          <div class="border-b-2 border-slate-900 pb-4 mb-4 flex items-center justify-between">
            <div>
              <h3 class="font-display text-xl font-bold uppercase tracking-wide text-slate-900">${appData.siteTitle}</h3>
              <p class="text-xs font-semibold text-slate-600 uppercase">Official Physical Fitness Test (PFT) Marksheet</p>
            </div>
            <div class="text-right text-xs text-slate-600">
              <p><strong>Date:</strong> ${today}</p>
              <p><strong>Status:</strong> <span class="${allPassed ? 'text-emerald-700' : 'text-red-700'} font-bold">${grade}</span></p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 bg-slate-100 p-3 rounded-lg text-xs mb-5">
            <div><span class="text-slate-500">Service No:</span> <strong>${svc}</strong></div>
            <div><span class="text-slate-500">Rank &amp; Name:</span> <strong>${rankName}</strong></div>
            <div><span class="text-slate-500">Unit / Base:</span> <strong>${unit}</strong></div>
          </div>

          <table class="w-full text-xs border-collapse mb-5">
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="p-2.5 text-left">Test Event</th>
                <th class="p-2.5 text-center">Performance</th>
                <th class="p-2.5 text-center">Marks</th>
                <th class="p-2.5 text-center">Result</th>
              </tr>
            </thead>
            <tbody>
              ${rows.map(r => `
                <tr class="border-b border-slate-200">
                  <td class="p-2.5 font-medium">${r.name}</td>
                  <td class="p-2.5 text-center">${r.raw}</td>
                  <td class="p-2.5 text-center font-bold">${r.score} / ${r.max}</td>
                  <td class="p-2.5 text-center font-bold ${r.passed ? 'text-emerald-700' : 'text-red-600'}">${r.passed ? 'PASS' : 'FAIL'}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>

          <div class="flex items-center justify-between bg-slate-100 p-4 rounded-xl text-sm">
            <div>
              <p class="text-xs text-slate-500">Total Score</p>
              <p class="font-bold text-lg text-slate-900">${totalObtained} / ${totalPossible} (${pct}%)</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-slate-500">Final Grade</p>
              <p class="font-bold text-lg ${allPassed ? 'text-emerald-700' : 'text-red-700'}">${grade}</p>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-300 flex items-center justify-between text-[11px] text-slate-500">
            <span>Verified by: ${appData.creator.name}</span>
            <button onclick="window.print()" class="no-print bg-slate-900 hover:bg-slate-800 text-white font-semibold px-4 py-2 rounded-lg text-xs">
              Print / Save PDF Marksheet
            </button>
          </div>
        </div>
      `;
    }

    // =========================================================================
    // 7. SEPARATE URL ADMIN PANEL (?admin)
    // =========================================================================
    let activeAdminTab = "general";

    function renderAdminPanel() {
      if (!isAdminAuthenticated) {
        return `
          <div class="max-w-sm mx-auto bg-slate-900 border border-slate-800 rounded-2xl p-6 mt-8 shadow-2xl">
            <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Restricted Access</span>
            <h2 class="font-display text-2xl font-bold text-white uppercase mt-1 mb-4">Admin Panel Login</h2>
            <input id="admin-pass-input" type="password" placeholder="Enter Admin Password" onkeydown="if(event.key==='Enter') verifyAdminLogin()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white mb-3" />
            <button onclick="verifyAdminLogin()" class="w-full bg-amber-600 hover:bg-amber-500 text-white font-semibold py-2.5 rounded-xl text-xs transition">
              Unlock Admin Panel
            </button>
          </div>
        `;
      }

      const tabs = [
        { id: "general", label: "General & Photos" },
        { id: "ptis", label: "PTIs (Diploma/MIC)" },
        { id: "guides", label: "Training Guides" },
        { id: "pft", label: "PFT Events & PDF" },
        { id: "firebase", label: "Firebase & Security" }
      ];

      return `
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Administrator Mode</span>
              <h2 class="font-display text-2xl font-bold text-white uppercase">System Control Panel</h2>
            </div>
            <button onclick="isAdminAuthenticated=false; goHome();" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-3.5 py-2 rounded-xl">Exit Admin</button>
          </div>

          <div class="flex flex-wrap gap-2 mb-6 border-b border-slate-800 pb-3">
            ${tabs.map(t => `
              <button onclick="activeAdminTab='${t.id}'; refreshUI();" class="px-3.5 py-2 rounded-xl text-xs font-semibold transition ${activeAdminTab === t.id ? 'bg-amber-600 text-white' : 'bg-slate-900 text-slate-400 hover:text-white'}">
                ${t.label}
              </button>
            `).join("")}
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
            ${renderAdminTabContent()}
          </div>
        </div>
      `;
    }

    function verifyAdminLogin() {
      const entered = document.getElementById("admin-pass-input").value;
      if (entered === appData.adminPassword) {
        isAdminAuthenticated = true;
        refreshUI();
      } else {
        alert("Incorrect Admin Password!");
      }
    }

    function renderAdminTabContent() {
      if (activeAdminTab === "general") {
        return `
          <div class="space-y-4">
            <div>
              <label class="block text-xs text-slate-300 mb-1">System Title</label>
              <input id="adm-site-title" type="text" value="${appData.siteTitle}" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white" />
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">Creator Name &amp; Service No</label>
              <input id="adm-creator-name" type="text" value="${appData.creator.name}" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white" />
            </div>
            <div>
              <label class="block text-xs text-slate-300 mb-1">Qualifications (One per line)</label>
              <textarea id="adm-creator-quals" rows="4" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white">${appData.creator.qualifications.join("\n")}</textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-slate-950 border border-slate-800 p-3.5 rounded-xl">
                <label class="block text-xs text-slate-300 mb-2">Upload Creator Photo</label>
                <input type="file" accept="image/*" onchange="handlePhotoUpload(event, 'creatorPhoto')" class="text-xs text-slate-400" />
              </div>
              <div class="bg-slate-950 border border-slate-800 p-3.5 rounded-xl">
                <label class="block text-xs text-slate-300 mb-2">Upload Profile Photo</label>
                <input type="file" accept="image/*" onchange="handlePhotoUpload(event, 'profilePhoto')" class="text-xs text-slate-400" />
              </div>
            </div>
            <button onclick="saveGeneralSettings()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-5 py-2.5 rounded-xl">Save General Settings</button>
          </div>
        `;
      }

      if (activeAdminTab === "ptis") {
        return `
          <div class="space-y-4">
            <h3 class="text-sm font-bold text-white">Manage Registered PTIs</h3>
            ${appData.ptis.map((p, idx) => `
              <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 flex items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] font-bold uppercase text-sky-400">${p.category}</span>
                  <p class="text-xs font-bold text-white">${p.name}</p>
                  <p class="text-[11px] text-slate-400">${p.qualification}</p>
                </div>
                <button onclick="appData.ptis.splice(${idx}, 1); saveData();" class="bg-rose-600/20 hover:bg-rose-600 text-rose-400 hover:text-white text-xs px-3 py-1.5 rounded-lg">Delete</button>
              </div>
            `).join("")}
          </div>
        `;
      }

      if (activeAdminTab === "guides") {
        return `
          <div class="space-y-5">
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
              <h3 class="text-xs font-bold uppercase text-emerald-400">Add New Training Guide</h3>
              <input id="adm-g-cat" type="text" placeholder="Category (e.g., Fat Burn, Cardio, Endurance, Agility)" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
              <input id="adm-g-title" type="text" placeholder="Guide Title" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
              <input id="adm-g-sum" type="text" placeholder="Short Summary" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
              <textarea id="adm-g-body" rows="3" placeholder="Detailed workout steps..." class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"></textarea>
              <button onclick="addNewGuide()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 py-2 rounded-lg">+ Add Guide</button>
            </div>
            <div class="space-y-2">
              ${appData.trainingGuides.map((g, idx) => `
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-emerald-400 font-bold uppercase">${g.category}</span>
                    <p class="text-xs font-bold text-white">${g.title}</p>
                  </div>
                  <button onclick="appData.trainingGuides.splice(${idx}, 1); saveData();" class="bg-rose-600/20 hover:bg-rose-600 text-rose-400 hover:text-white text-xs px-3 py-1.5 rounded-lg">Delete</button>
                </div>
              `).join("")}
            </div>
          </div>
        `;
      }

      if (activeAdminTab === "pft") {
        return `
          <div class="space-y-5">
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
              <h3 class="text-xs font-bold uppercase text-sky-400 mb-2">Upload Official PFT Standards PDF</h3>
              <input type="file" accept="application/pdf" onchange="handlePdfUpload(event)" class="text-xs text-slate-300" />
              ${appData.pftPdf.fileName ? `<p class="text-xs text-emerald-400 mt-2">Current PDF: ${appData.pftPdf.fileName}</p>` : ""}
            </div>

            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
              <h3 class="text-xs font-bold uppercase text-indigo-400">Add Custom PFT Event &amp; Scoring</h3>
              <input id="adm-ev-name" type="text" placeholder="Event Name (e.g., Shuttle Run 4x10m)" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
              <select id="adm-ev-type" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white">
                <option value="higher_better">Higher Number = Better (Push-ups, Sit-ups, Pull-ups)</option>
                <option value="lower_better">Lower Time = Better (Running / Sprint Seconds)</option>
              </select>
              <div class="grid grid-cols-3 gap-2">
                <input id="adm-ev-full" type="number" placeholder="100% Target" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
                <input id="adm-ev-pass" type="number" placeholder="Min Pass" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
                <input id="adm-ev-max" type="number" value="100" placeholder="Max Marks" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
              </div>
              <button onclick="addPftEvent()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-lg">+ Add PFT Event</button>
            </div>

            <div class="space-y-2">
              ${appData.pftEvents.map((ev, idx) => `
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-3 flex items-center justify-between text-xs">
                  <div>
                    <strong class="text-white">${ev.name}</strong>
                    <span class="text-slate-400 ml-2">(Full: ${ev.targetFull} | Pass: ${ev.minPass} | Max: ${ev.maxMarks})</span>
                  </div>
                  <button onclick="appData.pftEvents.splice(${idx}, 1); saveData();" class="bg-rose-600/20 hover:bg-rose-600 text-rose-400 hover:text-white px-2.5 py-1 rounded-lg">Delete</button>
                </div>
              `).join("")}
            </div>
          </div>
        `;
      }

      return `
        <div class="space-y-5">
          <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
            <h3 class="text-xs font-bold uppercase text-amber-400">Change Admin Password</h3>
            <input id="adm-new-pass" type="text" placeholder="Enter New Admin Password" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white" />
            <button onclick="changeAdminPassword()" class="bg-amber-600 hover:bg-amber-500 text-white text-xs font-semibold px-4 py-2 rounded-lg">Update Password</button>
          </div>

          <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
            <h3 class="text-xs font-bold uppercase text-sky-400">Connect Firebase Realtime Database (Live Sync)</h3>
            <p class="text-[11px] text-slate-400">Paste your Firebase Web App config JSON object below to sync all updates across devices.</p>
            <textarea id="adm-fb-config" rows="5" placeholder='{"apiKey":"...","authDomain":"...","databaseURL":"...","projectId":"..."}' class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs font-mono text-white">${appData.firebaseConfig ? JSON.stringify(appData.firebaseConfig, null, 2) : ""}</textarea>
            <button onclick="saveFirebaseConfig()" class="bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold px-4 py-2 rounded-lg">Connect &amp; Sync Firebase</button>
          </div>
        </div>
      `;
    }

    function handlePhotoUpload(event, key) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        appData.creator[key] = e.target.result;
        saveData();
        alert("Photo updated!");
      };
      reader.readAsDataURL(file);
    }

    function saveGeneralSettings() {
      appData.siteTitle = document.getElementById("adm-site-title").value.trim() || "Physical Training and Fitness System";
      appData.creator.name = document.getElementById("adm-creator-name").value.trim() || "40218 Sgt Suranga";
      appData.creator.qualifications = document.getElementById("adm-creator-quals").value.split("\n").map(s => s.trim()).filter(Boolean);
      saveData();
      alert("General settings saved!");
    }

    function addNewGuide() {
      const category = document.getElementById("adm-g-cat").value.trim();
      const title = document.getElementById("adm-g-title").value.trim();
      const summary = document.getElementById("adm-g-sum").value.trim();
      const content = document.getElementById("adm-g-body").value.trim();
      if (!category || !title || !content) return alert("Please fill Category, Title, and Content.");
      appData.trainingGuides.push({ id: "guide-" + Date.now(), category, title, summary, content });
      saveData();
    }

    function handlePdfUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        appData.pftPdf = { fileName: file.name, dataUrl: e.target.result };
        saveData();
        alert("PFT PDF Uploaded!");
      };
      reader.readAsDataURL(file);
    }

    function addPftEvent() {
      const name = document.getElementById("adm-ev-name").value.trim();
      const type = document.getElementById("adm-ev-type").value;
      const targetFull = parseFloat(document.getElementById("adm-ev-full").value);
      const minPass = parseFloat(document.getElementById("adm-ev-pass").value);
      const maxMarks = parseFloat(document.getElementById("adm-ev-max").value) || 100;
      if (!name || isNaN(targetFull) || isNaN(minPass)) return alert("Please fill all event values.");
      appData.pftEvents.push({ id: "ev-" + Date.now(), name, type, targetFull, minPass, maxMarks });
      saveData();
    }

    function changeAdminPassword() {
      const np = document.getElementById("adm-new-pass").value.trim();
      if (!np) return alert("Enter a valid password.");
      appData.adminPassword = np;
      saveData();
      alert("Admin password changed successfully!");
    }

    function saveFirebaseConfig() {
      try {
        const raw = document.getElementById("adm-fb-config").value.trim();
        appData.firebaseConfig = raw ? JSON.parse(raw) : null;
        saveData();
        initFirebaseIfConfigured();
        alert("Firebase configuration saved and connected!");
      } catch (e) {
        alert("Invalid JSON format. Please paste the exact Firebase config JSON.");
      }
    }

    // =========================================================================
    // MODALS (CREATOR & CONSULTATION)
    // =========================================================================
    function openCreatorModal() {
      document.getElementById("modal-creator-photo").src = appData.creator.creatorPhoto || DEFAULT_AVATAR;
      document.getElementById("modal-profile-photo").src = appData.creator.profilePhoto || DEFAULT_AVATAR;
      document.getElementById("modal-creator-name").textContent = appData.creator.name;
      document.getElementById("modal-qualifications-list").innerHTML = appData.creator.qualifications
        .map(q => `<li class="flex items-center gap-2"><span class="text-sky-400">✔</span><span>${q}</span></li>`).join("");
      document.getElementById("creator-modal").classList.remove("hidden");
    }

    function closeCreatorModal() {
      document.getElementById("creator-modal").classList.add("hidden");
    }

    function openConsultModal(ptiId) {
      activeConsultPti = appData.ptis.find(p => p.id === ptiId);
      if (!activeConsultPti) return;
      document.getElementById("consult-pti-target").textContent = `Instructor: ${activeConsultPti.name} (${activeConsultPti.category})`;
      document.getElementById("consult-modal").classList.remove("hidden");
    }

    function closeConsultModal() {
      document.getElementById("consult-modal").classList.add("hidden");
    }

    function sendWhatsAppConsultation() {
      if (!activeConsultPti) return;
      const sender = document.getElementById("consult-sender").value.trim() || "Trainee";
      const q = document.getElementById("consult-question").value.trim();
      if (!q) return alert("Please enter your question.");
      const text = encodeURIComponent(`*Physical Training & Fitness Inquiry*\nTo: ${activeConsultPti.name}\nFrom: ${sender}\n\nQuestion: ${q}`);
      window.open(`https://wa.me/${activeConsultPti.whatsapp}?text=${text}`, "_blank");
      closeConsultModal();
    }

    // Initialize App
    checkAdminUrl();
    initFirebaseIfConfigured();
    refreshUI();
  </script>
</body>
</html>
