<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Physical Training and Fitness System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Firebase Realtime Database SDKs -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #090d16; color: #f1f5f9; }
    .font-display { font-family: 'Oswald', sans-serif; letter-spacing: 0.03em; }
    @media print {
      body * { visibility: hidden; }
      #printable-marksheet, #printable-marksheet * { visibility: visible; }
      #printable-marksheet {
        position: fixed; left: 0; top: 0; width: 100%;
        background: white !important; color: black !important;
        padding: 24px; box-shadow: none !important;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- TOP NAVIGATION BAR -->
  <header class="bg-slate-900/95 border-b border-slate-800 sticky top-0 z-40 backdrop-blur">
    <div class="max-w-5xl mx-auto px-4 py-3.5 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 cursor-pointer" onclick="goHome()">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-blue-700 flex items-center justify-center shadow-lg shadow-sky-500/20">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <h1 id="header-site-title" class="font-display text-lg sm:text-xl font-bold text-white uppercase tracking-wide leading-tight">
            Physical Training and Fitness System
          </h1>
          <p class="text-[11px] text-sky-400 font-medium tracking-wider uppercase">SLAF Athletic &amp; Conditioning Portal</p>
        </div>
      </div>

      <!-- Compact Creator Button Only -->
      <button onclick="openCreatorModal()" class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-3.5 py-2 rounded-xl text-xs font-semibold transition shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Creator</span>
      </button>
    </div>
  </header>

  <!-- BREADCRUMB NAVIGATION BAR (Visible when inside a topic) -->
  <div id="breadcrumb-bar" class="hidden bg-slate-900/60 border-b border-slate-800/80">
    <div class="max-w-5xl mx-auto px-4 py-2.5 flex items-center justify-between text-xs">
      <div id="breadcrumb-trail" class="flex items-center gap-2 text-slate-400 flex-wrap"></div>
      <button onclick="goHome()" class="text-sky-400 hover:text-sky-300 font-semibold flex items-center gap-1">
        <span>← Home</span>
      </button>
    </div>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main id="app-container" class="flex-1 max-w-5xl w-full mx-auto px-4 py-8"></main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/80 py-4 text-center text-xs text-slate-500">
    <span id="footer-title">Physical Training and Fitness System</span> • Structured Conditioning &amp; PFT Evaluation
  </footer>

  <!-- COMPACT CREATOR MODAL -->
  <div id="creator-modal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4" onclick="if(event.target===this) closeCreatorModal()">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-sm w-full p-5 shadow-2xl relative">
      <button onclick="closeCreatorModal()" class="absolute top-3.5 right-3.5 text-slate-400 hover:text-white bg-slate-800 rounded-lg p-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <div class="flex items-center gap-3.5 mb-4">
        <img id="modal-creator-photo" src="" alt="Creator" class="w-16 h-16 rounded-xl object-cover border-2 border-sky-500 bg-slate-800" />
        <div>
          <span class="text-[10px] uppercase tracking-widest text-sky-400 font-bold">Creator</span>
          <h3 id="modal-creator-name" class="text-base font-bold text-white mt-0.5">40218 Sgt Suranga</h3>
          <div class="flex items-center gap-2 mt-1">
            <img id="modal-profile-photo" src="" alt="Profile" class="w-6 h-6 rounded-full object-cover border border-amber-400 bg-slate-800" />
            <span class="text-[11px] text-slate-400">Qualified PTI &amp; Sports Specialist</span>
          </div>
        </div>
      </div>

      <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3.5">
        <p class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Courses &amp; Qualifications</p>
        <ul id="modal-qualifications-list" class="space-y-1.5 text-xs text-slate-200"></ul>
      </div>
    </div>
  </div>

  <!-- CONSULTATION / ASK PTI MODAL -->
  <div id="consult-modal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4" onclick="if(event.target===this) closeConsultModal()">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-5 shadow-2xl">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-bold text-white">Request Fitness Advice / උපදෙස් ලබාගන්න</h3>
        <button onclick="closeConsultModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
      </div>
      <p id="consult-pti-target" class="text-xs text-sky-400 mb-3 font-medium"></p>
      <div class="space-y-3">
        <input id="consult-sender" type="text" placeholder="Your Service No / Name (ඔබේ නම හෝ අංකය)" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-sky-500 outline-none" />
        <textarea id="consult-question" rows="3" placeholder="Write your training, fat burn, or PFT question here..." class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-sky-500 outline-none"></textarea>
        <button onclick="sendWhatsAppConsultation()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-2">
          <span>Send via WhatsApp</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // DEFAULT DATA & FIREBASE-READY STORAGE ADAPTER
    // =========================================================================
    const DEFAULT_AVATAR = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%231e293b'/%3E%3Ccircle cx='50' cy='38' r='18' fill='%2338bdf8'/%3E%3Cpath d='M20 88c0-17 13-30 30-30s30 13 30 30' fill='%2338bdf8'/%3E%3C/svg%3E";

    const DEFAULT_DATA = {
      siteTitle: "Physical Training and Fitness System",
      adminPassword: "40218",
      firebaseConfig: null, // Paste Firebase JSON config in Admin Panel for live multi-device sync
      creator: {
        name: "40218 Sgt Suranga",
        creatorPhoto: DEFAULT_AVATAR,
        profilePhoto: DEFAULT_AVATAR,
        qualifications: [
          "Dip Sports NVQ IV",
          "Physical Training Instructor",
          "Trade Instructor",
          "Aerobic Training Instructor"
        ]
      },
      ptis: [
        {
          id: "pti-1",
          name: "40218 Sgt Suranga",
          category: "Diploma",
          qualification: "Dip Sports NVQ IV, PTI, Trade & Aerobic Instructor",
          specialty: "Athletic Conditioning, Fat Burn & PFT Preparation",
          whatsapp: "94784693750"
        },
        {
          id: "pti-2",
          name: "Cpl Perera K.M.",
          category: "MIC",
          qualification: "MIC Qualified Physical Training Instructor",
          specialty: "Endurance Running & Combat Fitness",
          whatsapp: "94784693750"
        }
      ],
      trainingGuides: [
        {
          id: "guide-fatburn",
          category: "Fat Burn",
          title: "Metabolic Conditioning & Fat Burn Protocol",
          summary: "Scientific approach to reducing body fat percentage while preserving lean muscle mass.",
          content: "1. Maintain Target Heart Rate between 65% - 75% of Max HR during steady-state sessions (35-45 mins).\n2. Incorporate HIIT (High-Intensity Interval Training) twice a week: 30 sec sprint / 45 sec active walk x 10 rounds.\n3. Maintain a controlled calorie deficit of 300-500 kcal/day with high protein intake (1.6g - 2.0g per kg bodyweight).\n4. Prioritize 7-8 hours of recovery sleep to regulate cortisol and optimize fat oxidation."
        },
        {
          id: "guide-cardio",
          category: "Cardio",
          title: "Aerobic Capacity & 2.4km Run Speed Work",
          summary: "Structured cardiovascular drills to improve VO2 max and PFT run timings.",
          content: "1. Tempo Runs: Run 20 minutes at a comfortably hard pace (80-85% effort) once per week.\n2. 400m Track Repeats: Complete 6 x 400m at faster than target 2.4km race pace with 90 seconds rest.\n3. Breathing Rhythm: Practice 2:2 rhythmic breathing (2 steps inhale, 2 steps exhale) to delay diaphragm fatigue.\n4. Dynamic Warm-up: Always perform 10 minutes of leg swings, high knees, and butt kicks before speed work."
        },
        {
          id: "guide-endurance",
          category: "Endurance",
          title: "Muscular & Stamina Endurance Building",
          summary: "Progressive overload circuits for Push-ups, Sit-ups, Pull-ups, and long-distance stamina.",
          content: "1. Grease-the-Groove Method: Perform 50% of your max Push-ups/Pull-ups 4 times throughout the day with full recovery.\n2. Pyramid Sets: 1-2-3-4-5-4-3-2-1 Pull-ups with 30 seconds rest between rungs.\n3. Core Stability: Hold front plank for 60s, side planks 45s each side, and 25 hollow-body rocks x 3 rounds.\n4. Long Slow Distance (LSD): 45-60 minute steady aerobic run at conversational pace every weekend."
        }
      ],
      pftPdf: {
        fileName: "",
        dataUrl: ""
      },
      pftEvents: [
        { id: "ev-run", name: "2.4 km Run (Seconds)", type: "lower_better", targetFull: 540, minPass: 720, maxMarks: 100 },
        { id: "ev-push", name: "Push-ups (2 Mins)", type: "higher_better", targetFull: 55, minPass: 30, maxMarks: 100 },
        { id: "ev-sit", name: "Sit-ups (2 Mins)", type: "higher_better", targetFull: 60, minPass: 35, maxMarks: 100 },
        { id: "ev-pull", name: "Pull-ups (Max Reps)", type: "higher_better", targetFull: 12, minPass: 5, maxMarks: 100 }
      ]
    };

    const STORAGE_KEY = "slaf_pt_fitness_system_v2";
    let appData = JSON.parse(localStorage.getItem(STORAGE_KEY)) || JSON.parse(JSON.stringify(DEFAULT_DATA));
    let dbRef = null;

    function initFirebaseIfConfigured() {
      if (appData.firebaseConfig && typeof firebase !== "undefined") {
        try {
          if (!firebase.apps.length) {
            firebase.initializeApp(appData.firebaseConfig);
          }
          dbRef = firebase.database().ref("pt_fitness_system_data");
          dbRef.on("value", (snapshot) => {
            const val = snapshot.val();
            if (val) {
              appData = { ...DEFAULT_DATA, ...val };
              localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
              refreshUI();
            }
          });
        } catch (err) {
          console.error("Firebase init error:", err);
        }
      }
    }

    function saveData() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
      if (dbRef) {
        dbRef.set(appData).catch(e => console.error("Firebase sync failed:", e));
      }
      refreshUI();
    }

    // =========================================================================
    // NAVIGATION & STATE
    // =========================================================================
    let currentView = "home"; // home | subtopics | pti_list | guide_detail | calculators | pft_system | admin
    let selectedMainTopic = null;
    let selectedSubParam = null;
    let isAdminAuthenticated = false;
    let activeConsultPti = null;

    function checkAdminUrl() {
      const params = new URLSearchParams(window.location.search);
      if (params.has("admin") || window.location.hash === "#admin") {
        currentView = "admin";
      }
    }

    function goHome() {
      if (window.location.search.includes("admin")) {
        window.history.replaceState({}, document.title, window.location.pathname);
      }
      currentView = "home";
      selectedMainTopic = null;
      selectedSubParam = null;
      refreshUI();
    }

    function openMainTopic(topicId) {
      selectedMainTopic = topicId;
      currentView = "subtopics";
      refreshUI();
    }

    function openSubTopic(view, param = null) {
      currentView = view;
      selectedSubParam = param;
      refreshUI();
    }

    function refreshUI() {
      document.getElementById("header-site-title").textContent = appData.siteTitle;
      document.getElementById("footer-title").textContent = appData.siteTitle;
      document.title = appData.siteTitle;

      const bcBar = document.getElementById("breadcrumb-bar");
      const bcTrail = document.getElementById("breadcrumb-trail");
      if (currentView === "home") {
        bcBar.classList.add("hidden");
      } else {
        bcBar.classList.remove("hidden");
        bcTrail.innerHTML = buildBreadcrumb();
      }

      const container = document.getElementById("app-container");
      if (currentView === "home") container.innerHTML = renderHome();
      else if (currentView === "subtopics") container.innerHTML = renderSubtopics();
      else if (currentView === "pti_list") container.innerHTML = renderPtiList();
      else if (currentView === "guide_detail") container.innerHTML = renderGuideDetail();
      else if (currentView === "calculators") container.innerHTML = renderCalculators();
      else if (currentView === "pft_system") container.innerHTML = renderPftSystem();
      else if (currentView === "admin") container.innerHTML = renderAdminPanel();
    }

    function buildBreadcrumb() {
      let html = `<button onclick="goHome()" class="hover:text-white">Home</button>`;
      if (selectedMainTopic && currentView !== "admin") {
        const names = {
          pti: "PTI Directory & Registration",
          guides: "Training Modules",
          calculators: "Fitness Calculators",
          pft: "Physical Fitness Test (PFT)"
        };
        html += ` <span>/</span> <button onclick="openMainTopic('${selectedMainTopic}')" class="hover:text-white">${names[selectedMainTopic]}</button>`;
      }
      if (currentView === "admin") {
        html += ` <span>/</span> <span class="text-amber-400 font-semibold">Admin Panel</span>`;
      } else if (currentView !== "subtopics" && selectedSubParam) {
        html += ` <span>/</span> <span class="text-sky-400 font-semibold">${selectedSubParam}</span>`;
      }
      return html;
    }

    // =========================================================================
    // 1. CLEAN HOME SCREEN (Main Topic Buttons Only)
    // =========================================================================
    function renderHome() {
      const topics = [
        {
          id: "pti",
          title: "PTI Directory & Advice",
          si: "පුහුණු උපදේශකයින් (Diploma & MIC PTIs)",
          desc: "View Diploma & MIC qualified PTIs, register new instructors, and request personal fitness guidance.",
          accent: "from-sky-500 to-blue-600",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>`
        },
        {
          id: "guides",
          title: "Training Modules",
          si: "පුහුණු ක්‍රමවේද (Fat Burn, Cardio & Endurance)",
          desc: "Structured protocols for fat loss, cardiovascular conditioning, and muscular endurance.",
          accent: "from-emerald-500 to-teal-600",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>`
        },
        {
          id: "calculators",
          title: "Fitness Calculators",
          si: "ශාරීරික මිනුම් ගණනය කිරීම් (BMI, Heart Rate, Body Fat)",
          desc: "Calculate BMI, Navy Body Fat %, Target Heart Rate zones, Daily Hydration, and Calorie needs.",
          accent: "from-amber-500 to-orange-600",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>`
        },
        {
          id: "pft",
          title: "Physical Fitness Test (PFT)",
          si: "ශාරීරික යෝග්‍යතා පරීක්ෂණය සහ ලකුණු පත්‍රිකාව",
          desc: "Access official PFT PDF standards, auto-calculate event scores, and generate printable marksheets.",
          accent: "from-indigo-500 to-purple-600",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>`
        }
      ];

      return `
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-8">
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-white uppercase tracking-wide">Select a Training Module</h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">Tap any main topic below to explore sub-topics and tools</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            ${topics.map(t => `
              <button onclick="openMainTopic('${t.id}')" class="group text-left bg-slate-900/90 hover:bg-slate-800/95 border border-slate-800 hover:border-sky-500/60 rounded-2xl p-6 transition-all shadow-lg hover:shadow-sky-500/10 flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br ${t.accent} flex items-center justify-center mb-4 shadow-md group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">${t.icon}</svg>
                  </div>
                  <h3 class="font-display text-xl font-bold text-white uppercase tracking-wide group-hover:text-sky-400 transition-colors">${t.title}</h3>
                  <p class="text-xs text-sky-400/90 font-medium mt-0.5">${t.si}</p>
                  <p class="text-xs text-slate-400 mt-2.5 leading-relaxed">${t.desc}</p>
                </div>
                <div class="mt-5 flex items-center text-xs font-semibold text-slate-300 group-hover:text-white">
                  <span>Open Sub-Topics</span>
                  <span class="ml-1.5 group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </button>
            `).join("")}
          </div>
        </div>
      `;
    }

    // =========================================================================
    // 2. SUB-TOPICS DRILL-DOWN VIEW
    // =========================================================================
    function renderSubtopics() {
      if (selectedMainTopic === "pti") {
        return `
          <div class="max-w-2xl mx-auto space-y-3">
            <h2 class="font-display text-2xl font-bold text-white uppercase mb-4">PTI Directory &amp; Consultation</h2>
            <button onclick="openSubTopic('pti_list', 'Diploma')" class="w-full text-left bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-sky-500 rounded-xl p-5 flex items-center justify-between transition">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-sky-400">Category 01</span>
                <h3 class="text-base font-bold text-white mt-0.5">Diploma Qualified PTIs (ඩිප්ලෝමාධාරී PTI උපදේශකයින්)</h3>
                <p class="text-xs text-slate-400 mt-1">View registered Diploma in Sports Science PTIs &amp; request advice</p>
              </div>
              <span class="text-sky-400 font-bold text-lg">→</span>
            </button>
            <button onclick="openSubTopic('pti_list', 'MIC')" class="w-full text-left bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-amber-500 rounded-xl p-5 flex items-center justify-between transition">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400">Category 02</span>
                <h3 class="text-base font-bold text-white mt-0.5">MIC Qualified PTIs (MIC පාඨමාලාධාරී PTI උපදේශකයින්)</h3>
                <p class="text-xs text-slate-400 mt-1">View registered MIC Physical Training Instructors &amp; request advice</p>
              </div>
              <span class="text-amber-400 font-bold text-lg">→</span>
            </button>
            <button onclick="openSubTopic('pti_list', 'Register')" class="w-full text-left bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500 rounded-xl p-5 flex items-center justify-between transition">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Instructor Onboarding</span>
                <h3 class="text-base font-bold text-white mt-0.5">Register as a PTI (නව PTI ලියාපදිංචිය - Diploma / MIC)</h3>
                <p class="text-xs text-slate-400 mt-1">Register separately under Diploma or MIC category</p>
              </div>
              <span class="text-emerald-400 font-bold text-lg">→</span>
            </button>
          </div>
        `;
      }

      if (selectedMainTopic === "guides") {
        return `
          <div class="max-w-2xl mx-auto space-y-3">
            <h2 class="font-display text-2xl font-bold text-white uppercase mb-4">Training Modules &amp; Guides</h2>
            ${appData.trainingGuides.map(g => `
              <button onclick="openSubTopic('guide_detail', '${g.id}')" class="w-full text-left bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-emerald-500 rounded-xl p-5 flex items-center justify-between transition">
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">${g.category}</span>
                  <h3 class="text-base font-bold text-white mt-0.5">${g.title}</h3>
                  <p class="text-xs text-slate-400 mt-1">${g.summary}</p>
                </div>
                <span class="text-emerald-400 font-bold text-lg">→</span>
              </button>
            `).join("")}
          </div>
        `;
      }

